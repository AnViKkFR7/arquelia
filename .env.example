# Supabase (misma instancia multi-tenant compartida con Navagli y otras empresas)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# company_id devuelto por database/001_arquelia_setup.sql al ejecutarlo
VITE_ARQUELIA_COMPANY_ID=00000000-0000-0000-0000-000000000000

# Analítica propia (ver ANALYTICS_INTEGRATION.md) — servidor únicamente, las
# lee api/track.ts. NUNCA con prefijo VITE_: eso las metería en el bundle del
# cliente y expondría la service role key, que se salta RLS por completo.
# Mismo proyecto Supabase de arriba, pero la Service role key (no la anon)
# está en Supabase → Settings → API → service_role.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Envío del formulario de presupuesto (api/contact.ts) — servidor únicamente.
# resend.com: crea la cuenta, verifica el dominio arquelia.es (registros DNS
# que da su panel) y genera una API key. RESEND_FROM_EMAIL debe ser una
# dirección de ese dominio ya verificado, si no Resend rechaza el envío.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Arquelia <formulario@arquelia.es>

# Google Tag Manager — ID del contenedor (tagmanager.google.com). Sin esta
# variable, `loadGTM()` no hace nada: el aviso de cookies sigue funcionando,
# pero no se carga ningún tag aunque el usuario acepte.
VITE_GTM_ID=GTM-XXXXXXX
