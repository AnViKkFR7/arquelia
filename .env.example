# Supabase (misma instancia multi-tenant compartida con Navagli y otras empresas)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# company_id devuelto por database/001_arquelia_setup.sql al ejecutarlo
VITE_ARQUELIA_COMPANY_ID=00000000-0000-0000-0000-000000000000

# Analítica propia (ver ANALYTICS_INTEGRATION.md) y envío del formulario de
# presupuesto viven en supabase/functions/{track,send-contact}-arquelia —
# Supabase Edge Functions, NO funciones de Vercel, así que sus credenciales
# no van en este archivo ni en Vercel:
#   - SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: no hace falta configurarlas,
#     toda Edge Function del proyecto ya las recibe inyectadas automáticamente.
#   - RESEND_API_KEY: sí hay que darla de alta a mano, como secreto de Supabase:
#       supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxx
#     (crea antes la cuenta en resend.com y verifica el dominio arquelia.es —
#     info@arquelia.es, el remitente fijado en la función, debe ser de ese
#     dominio ya verificado, si no Resend rechaza el envío).

# Google Tag Manager — ID del contenedor (tagmanager.google.com). Sin esta
# variable, `loadGTM()` no hace nada: el aviso de cookies sigue funcionando,
# pero no se carga ningún tag aunque el usuario acepte.
VITE_GTM_ID=GTM-XXXXXXX
